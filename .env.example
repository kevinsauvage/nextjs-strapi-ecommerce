# =============================================================================
# REQUIRED ENVIRONMENT VARIABLES
# =============================================================================
# These variables are required for the application to function properly.
# Without them, the application will not be able to connect to Shopify.

# Shopify Storefront API access token
# Get this from your Shopify admin: Settings > Apps and sales channels > 
# Develop apps > [Your app] > API credentials > Storefront API access token
SHOPIFY_STORE_FRONT_ACCESS_TOKEN=your_storefront_access_token

# Shopify Storefront API GraphQL endpoint URL
# Format: https://your-store.myshopify.com/api/2025-01/graphql.json
# Replace 'your-store' with your actual Shopify store domain
NEXT_PUBLIC_SHOPIFY_STOREFRONT_URL=https://your-store.myshopify.com/api/2025-01/graphql.json


# =============================================================================
# OPTIONAL ENVIRONMENT VARIABLES
# =============================================================================
# These variables are optional and enable additional features.
# The application will work without them, but some features may be unavailable.

# -----------------------------------------------------------------------------
# Shopify Admin API (Optional)
# -----------------------------------------------------------------------------
# Required only if you need to use Shopify Admin API features (e.g., customer
# management, product updates via admin API, etc.)
# Get this from your Shopify admin: Settings > Apps and sales channels >
# Develop apps > [Your app] > API credentials > Admin API access token

# Shopify Admin API access token
SHOPIFY_STORE_FRONT_ADMIN_TOKEN=your_admin_access_token

# Shopify Admin API GraphQL endpoint URL
# Format: https://your-store.myshopify.com/admin/api/2025-01/graphql.json
SHOPIFY_ADMIN_URL=https://your-store.myshopify.com/admin/api/2025-01/graphql.json

# Delegate token scope (comma-separated)
# Used for unauthenticated access to specific resources
# Example: unauthenticated_read_product_listings,unauthenticated_read_product_inventory
SHOPIFY_SCOPE=unauthenticated_read_product_listings,unauthenticated_read_product_inventory


# -----------------------------------------------------------------------------
# Site Configuration (Optional)
# -----------------------------------------------------------------------------
# Used for cookie settings, robots.txt, sitemap generation, etc.

# Your site domain (without protocol)
# Example: yourdomain.com
NEXT_PUBLIC_SITE_DOMAIN=yourdomain.com

# Base URL for the application (with protocol)
# Used for robots.txt, sitemap, and other absolute URL generation
# Example: https://yourdomain.com
NEXT_PUBLIC_BASE_URL=https://yourdomain.com


# -----------------------------------------------------------------------------
# Analytics (Optional)
# -----------------------------------------------------------------------------
# Google Tag Manager container ID
# Get this from your Google Tag Manager account
# Format: GTM-XXXXXXX (where XXXXXXX is your container ID)
# Note: This is for GTM, not GA4. For GA4 directly, you would need a different integration.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX


# =============================================================================
# STANDARD NEXT.JS VARIABLES
# =============================================================================
# Standard Next.js environment variable
# Options: development, production, test
NODE_ENV=development
